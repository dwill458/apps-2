# Application Settings
APP_NAME="Sports Betting Prediction Engine"
APP_VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=True
SECRET_KEY="your-secret-key-here-change-in-production"

# Database Configuration
DATABASE_URL="postgresql+asyncpg://user:password@localhost:5432/sports_betting_db"
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis Configuration
REDIS_URL="redis://localhost:6379/0"
REDIS_CACHE_TTL=300

# API Keys for Sports Data Providers
# The Odds API (https://the-odds-api.com/)
ODDS_API_KEY="your-odds-api-key-here"
ODDS_API_BASE_URL="https://api.the-odds-api.com/v4"

# Alternative providers (uncomment to use)
# SPORTRADAR_API_KEY="your-sportradar-key"
# FANDUEL_API_KEY="your-fanduel-key"

# Security
CORS_ORIGINS="http://localhost:3000,http://localhost:8000"
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
API_CALL_TIMEOUT=30

# Geo-Fencing Configuration
ENABLE_GEO_FENCING=True
ALLOWED_STATES="NJ,PA,IN,WV,CO,TN,VA,IA,IL,MI,AZ,LA,NY,CT,KS,MD,OH,WY,MA"
GEOIP_DATABASE_PATH="./data/GeoLite2-City.mmdb"

# AI Model Configuration
MODEL_CONFIDENCE_THRESHOLD=0.65
PREDICTION_HISTORY_DAYS=90
MIN_HISTORICAL_SAMPLES=50

# Data Refresh Intervals (seconds)
ODDS_REFRESH_INTERVAL=300
STATS_REFRESH_INTERVAL=3600
HISTORICAL_DATA_REFRESH_INTERVAL=86400

# Logging
LOG_LEVEL="INFO"
LOG_FORMAT="json"

# Monitoring
SENTRY_DSN=""
ENABLE_METRICS=True
